{
  "name": "categorise_frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --fix",
    "generate-api-types": "openapi-generator-cli generate -i http://localhost:3050/openapi.json -g typescript-axios -o src/types/generated",
    "format": "prettier --write src/",
    "analyse-bundle": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "uuid": "^14.0.2",
    "vite-bundle-analyzer": "^1.3.9",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vue/typescript-plugin": "^3.3.12",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  }
}
